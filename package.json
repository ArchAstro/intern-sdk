{
  "name": "@archastro/intern-sdk",
  "version": "0.1.0",
  "description": "Typed client and runtime plugin contract for Intern sites",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "import": "./dist/runtime/index.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "import": "./dist/testing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.types.json",
    "test": "vitest run",
    "test:package": "node scripts/package-smoke.mjs",
    "check": "npm run format:check && npm run typecheck && npm run build && npm test && npm run test:package",
    "prepare": "npm run build",
    "prepack": "npm run build"
  },
  "keywords": [
    "archastro",
    "intern",
    "sdk",
    "typescript"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ArchAstro/intern-sdk.git"
  },
  "homepage": "https://tryintern.dev",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "22.18.6",
    "prettier": "3.6.2",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
